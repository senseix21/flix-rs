CONFIG_IDF_TARGET="esp32s3"
CONFIG_FLIX_PWM_ENABLE=y
CONFIG_FLIX_MOTOR_RL=4
CONFIG_FLIX_MOTOR_RR=5
CONFIG_FLIX_MOTOR_FR=6
CONFIG_FLIX_MOTOR_FL=7
CONFIG_FLIX_GATE_PIN=8
CONFIG_FLIX_I2C_SDA=9
CONFIG_FLIX_I2C_SCL=10
CONFIG_FLIX_RC_PIN=11
CONFIG_FLIX_WIFI_ENABLE=y
CONFIG_FLIX_WIFI_SSID="compile-only"
CONFIG_FLIX_WIFI_PASSWORD="compile-only-no-radio"
